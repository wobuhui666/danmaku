# 环境变量配置示例

# ==========================================
# 域名配置选项
# ==========================================

# 选项1: 完整自定义域名（优先级最高）
# 使用完整的域名URL，包括协议
# CUSTOM_DOMAIN=https://api.example.com

# 选项2: 分别配置协议和主机
# 自定义协议 (http 或 https)
# CUSTOM_PROTOCOL=https
# 自定义主机名（可包含端口）
# CUSTOM_HOST=myapp.example.com

# 选项3: 强制使用HTTPS（适用于反向代理场景）
# FORCE_HTTPS=true

# 域名覆盖模式
# auto: 自动检测（默认）
# custom: 完全使用自定义配置
# hybrid: 混合模式
# DOMAIN_OVERRIDE_MODE=auto

# ==========================================
# 部署场景示例
# ==========================================

# Docker + Nginx反向代理
# CUSTOM_DOMAIN=https://api.example.com

# Heroku部署
# CUSTOM_PROTOCOL=https
# CUSTOM_HOST=myapp.herokuapp.com

# 本地开发（无需配置，使用默认行为）

# ==========================================
# 其他环境变量
# ==========================================

# 端口配置
# PORT=3000

# 数据库等其他配置...